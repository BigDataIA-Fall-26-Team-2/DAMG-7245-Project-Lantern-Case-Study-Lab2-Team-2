# Copy this file to .env in the repository root and fill in your key.
# .env is ignored by Git. Never put real credentials in this example file.

# Classroom notebooks use replay; Exercise 0 needs record for its new request.
LANTERN_LLM_MODE=replay

# OpenRouter credentials via the starter's OpenAI-compatible client.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=

# The starter does not automatically load .env. Before importing src.llm.client:
# from dotenv import load_dotenv
# load_dotenv(ROOT / ".env", override=True)
# Restart the notebook kernel after changing credentials or mode.
#
# Before a real OpenRouter call, also configure an OpenRouter model identifier
# and matching current prices. This file alone does not change params.yaml.
# Keep classroom replay model settings intact so existing cache keys still match.
